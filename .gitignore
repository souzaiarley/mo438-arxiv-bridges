# --- Data and regenerable caches ----------------------------------------------
# data/raw/arxiv.zip (~83 MB, `mo438 download`) and data/processed/ (parsed arrays,
# distance cache and the per-edge/per-vertex caches, keyed by the GraphML SHA-256) are
# regenerated by the commands; never commit them. The GraphML instances in
# outputs/graphml/ ARE versioned, through Git LFS (see .gitattributes).
data/

# Temporary files written atomically by the commands (*.tmp, *.part, *.tmp.npz)
*.tmp
*.part
*.tmp.npz

